# Configuración del backend del portal SIO (ejemplo, sin valores reales)
#
# Lo lee docker-compose.yml (env_file). En el servidor, copiar a
# /etc/sio-portal/backend.env, rellenar y protegerlo:
#   sudo mkdir -p /etc/sio-portal
#   sudo cp deploy/backend.env.example /etc/sio-portal/backend.env
#   sudo chmod 600 /etc/sio-portal/backend.env
# No subir nunca el archivo rellenado al repositorio.

# Clave para firmar la cookie de sesión. Generar una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SIO_SECRET_KEY=

# Usuario y contraseña de la intranet. El hash de la contraseña se genera con:
#   sudo docker compose run --rm backend python -c "from werkzeug.security import generate_password_hash as g; print(g('LA_CONTRASEÑA'))"
# (o en local: backend/venv/bin/python -c "...")
# Copiar el resultado ENTRE COMILLAS SIMPLES: el hash tiene símbolos $ y, sin
# comillas, Docker Compose los interpretaría como variables y lo estropearía.
#   SIO_ADMIN_PASSWORD_HASH='scrypt:32768:8:1$...$...'
SIO_ADMIN_USER=
SIO_ADMIN_PASSWORD_HASH=''

# Servidor de correo para el formulario de contacto (pedir los datos a Informática)
SIO_SMTP_HOST=
SIO_SMTP_PORT=25
SIO_SMTP_STARTTLS=0
SIO_SMTP_USER=
SIO_SMTP_PASSWORD=
# Remitente y destinatario de las consultas
SIO_SMTP_FROM=sio@icm.csic.es
SIO_CONTACTO_DESTINO=sio@icm.csic.es

# Poner a 1 cuando la web ya funcione con HTTPS (la cookie de sesión solo viajará cifrada)
SIO_COOKIE_SEGURA=0
